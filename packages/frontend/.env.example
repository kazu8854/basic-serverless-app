# Only needed for `npm run dev:aws` (frontend running locally against a
# REAL deployed backend/Cognito, i.e. MOCK_AWS=false). Copy to `.env` and
# fill in with the values from `cdk deploy`'s CfnOutputs (or `cdk deploy`'s
# stdout / the AWS Console > CloudFormation > Outputs).
#
# In a real deployment (served from CloudFront) none of this is needed —
# the frontend fetches these same values at runtime from `/config.json`,
# which CDK generates automatically (see packages/infrastructure).

VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod/
VITE_AWS_REGION=us-east-1
VITE_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=https://basic-serverless-app-xxxxxxxxxxxx.auth.us-east-1.amazoncognito.com
